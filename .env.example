# ---------------------------------------------------------------------------
# Anthropic (required) — the AI engine behind invoice extraction.
# Create a key at https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Defaults to claude-opus-5.
# Other options: claude-sonnet-5 (cheaper/faster), claude-haiku-4-5 (cheapest).
ANTHROPIC_MODEL="claude-opus-5"

# Optional. Only set this when routing through a proxy or gateway.
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Optional. Reasoning depth: low | medium | high | xhigh | max. Defaults to medium.
ANTHROPIC_EFFORT="medium"

# ---------------------------------------------------------------------------
# Google Drive import (optional) — leave blank to hide the Drive tab.
# Values come from your Firebase web app config.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
